{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/big-pickle",
  "permission": {
    "read": "allow",
    "edit": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "bash": {
    "*": "ask",
        "pnpm install": "allow",
        "pnpm run *": "allow",
        "git status": "allow",
        "git diff *": "allow",
        "git log *": "allow"
    },
    "task" : "allow",
    "webfetch": "allow",
    "websearch": "allow"
  }
}